# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# API-ключ Scitely — бесплатно, 60 запросов/мин, 15+ моделей, без карты
# Получить: https://console.scitely.com
SCITELY_API_KEY=your_scitely_api_key_here

# Модель: deepseek-v3.2, qwen3-max, qwen3-32b, deepseek-r1, kimi-k2-0905
# SCITELY_MODEL=deepseek-v3.2

# Cloudflare Worker — прокси для TELEGRAM API (api.telegram.org)
# Полный URL воркера, например: https://telegram-api-proxy.xxx.workers.dev
# См. CLOUDFLARE_SETUP.md для создания воркера
# TELEGRAM_API_URL=

# Альтернатива: HTTP/SOCKS5 прокси
# Примеры: http://127.0.0.1:7890  или  socks5://user:pass@host:port
# PROXY=
