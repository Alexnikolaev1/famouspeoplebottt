# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# === Yandex Cloud AI (приоритет, оплата картой РФ) — см. YANDEX_SETUP.md ===
# YANDEX_FOLDER_ID=   # ID каталога из console.cloud.yandex.ru
# YANDEX_API_KEY=    # API-ключ сервисного аккаунта с ролью ai.languageModels.user

# === Google Gemini (если Yandex не задан) ===
# API-ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Несколько ключей через запятую — при 429 пробует следующий
# GEMINI_API_KEYS=key1,key2,key3

# Модель (по умолчанию gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Сколько пар user+assistant хранить в контексте (по умолчанию 3). Меньше = экономия токенов.
# GEMINI_MAX_HISTORY_PAIRS=3

# Лимит токенов ответа (по умолчанию 4096). Больше = длиннее ответы, но выше расход.
# GEMINI_MAX_OUTPUT_TOKENS=4096

# Cloudflare Worker — прокси для Gemini (если регион заблокирован)
# Полный URL воркера, например: https://gemini-proxy.xxx.workers.dev
# См. CLOUDFLARE_SETUP.md для создания воркера
# GEMINI_WORKER_URL=

# Cloudflare Worker — прокси для TELEGRAM API (api.telegram.org)
# Полный URL воркера, например: https://telegram-api-proxy.xxx.workers.dev
# См. CLOUDFLARE_SETUP.md для создания воркера
# TELEGRAM_API_URL=

# Альтернатива: HTTP/SOCKS5 прокси
# Примеры: http://127.0.0.1:7890  или  socks5://user:pass@host:port
# PROXY=
