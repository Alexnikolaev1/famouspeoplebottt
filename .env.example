# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# API-ключ Alibaba Model Studio для Qwen (https://modelstudio.console.alibabacloud.com/)
# Важно: ключ должен быть из того же региона, что и base_url!
# Singapore (free trial): https://modelstudio.console.alibabacloud.com/?tab=playground#/api-key
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Base URL по региону (если ключ из US или China — укажите свой):
# Singapore: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# US Virginia: https://dashscope-us.aliyuncs.com/compatible-mode/v1
# China: https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_BASE_URL=

# Модель (по умолчанию qwen-plus — в free trial; qwen3.5-plus требует активации)
# DASHSCOPE_MODEL=qwen-plus

# Режим размышлений (опционально, может вызывать ошибки)
# DASHSCOPE_ENABLE_THINKING=0

# Cloudflare Worker — прокси для TELEGRAM API (api.telegram.org)
# Полный URL воркера, например: https://telegram-api-proxy.xxx.workers.dev
# См. CLOUDFLARE_SETUP.md для создания воркера
# TELEGRAM_API_URL=

# Альтернатива: HTTP/SOCKS5 прокси
# Примеры: http://127.0.0.1:7890  или  socks5://user:pass@host:port
# PROXY=
