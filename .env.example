# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# API-ключ Google Gemini (https://ai.google.dev/)
# Поддерживаются переменные: GEMINI_API_KEY или GOOGLE_API_KEY
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare Worker — прокси для GEMINI API (generativelanguage.googleapis.com)
# НЕ путать с TELEGRAM_API_URL! Это разные воркеры.
# По умолчанию: https://gemini-proxy.alex555196.workers.dev
# GEMINI_WORKER_URL=https://gemini-proxy.alex555196.workers.dev

# Cloudflare Worker — прокси для TELEGRAM API (api.telegram.org)
# Полный URL воркера, например: https://telegram-api-proxy.xxx.workers.dev
# См. CLOUDFLARE_SETUP.md для создания воркера
# TELEGRAM_API_URL=

# Альтернатива: HTTP/SOCKS5 прокси
# Примеры: http://127.0.0.1:7890  или  socks5://user:pass@host:port
# PROXY=
